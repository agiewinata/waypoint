// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  sessions Session[]
  accounts Account[]

  renter        Renter?
  rentee        Rentee?
  admin         Admin?
  notifications Notification[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum VehicleType {
  Sedan
  SUV
  MPV
  Hatchback
  Pickup
  Motorcycle
}

enum VehicleStatus {
  Draft
  Pending
  Approved
  Rejected
}

enum BookingStatus {
  Pending
  Confirmed
  Declined
  Cancelled
  Active
  Completed
  Failed
}

enum PaymentStatus {
  Pending
  Held
  Released
  Failed
}

enum DocumentType {
  STNK
  Insurance
  KTP
  SIM
}

enum VerificationStatus {
  Unverified
  Pending
  Verified
  Rejected
}

enum DisputeStatus {
  Open
  UnderReview
  Resolved
  Rejected
}

enum DisputeRaiser {
  Renter
  Rentee
}

// ---------------------------------------------------------------------------
// Domain models
// ---------------------------------------------------------------------------

model Renter {
  renterID           String             @id @default(cuid())
  userID             String?            @unique
  name               String
  email              String
  phone              String
  address            String
  verificationStatus VerificationStatus @default(Unverified)

  user      User?      @relation(fields: [userID], references: [id], onDelete: Restrict)
  vehicles  Vehicle[]
  documents Document[]

  @@index([userID])
}

model Rentee {
  renteeID           String             @id @default(cuid())
  userID             String?            @unique
  name               String
  email              String
  phone              String
  address            String
  verificationStatus VerificationStatus @default(Unverified)
  lastKnownLat       Decimal?           @db.Decimal(9, 6)
  lastKnownLng       Decimal?           @db.Decimal(9, 6)
  lastSeenAt         DateTime?

  user         User?         @relation(fields: [userID], references: [id], onDelete: Restrict)
  bookings     Booking[]
  locationLogs LocationLog[]
  documents    Document[]

  @@index([userID])
}

model Admin {
  adminID    String @id @default(cuid())
  userID     String @unique
  name       String
  email      String
  permission String

  user              User?      @relation(fields: [userID], references: [id], onDelete: Restrict)
  verifiedDocuments Document[] @relation("VerifiedByAdmin")
  approvedBookings  Booking[]  @relation("ApprovedByAdmin")
  resolvedDisputes  Dispute[]  @relation("ResolvedByAdmin")

  @@index([userID])
}

model Vehicle {
  VIN         String        @id @db.VarChar(17)
  renterID    String
  listingCode String        @unique
  make        String
  model       String
  year        Int
  plateNumber String        @unique
  type        VehicleType
  city        String
  pricePerDay Decimal       @db.Decimal(12, 2)
  status      VehicleStatus @default(Draft)
  createdAt   DateTime      @default(now())

  renter    Renter     @relation(fields: [renterID], references: [renterID], onDelete: Restrict)
  bookings  Booking[]
  documents Document[]

  @@index([renterID])
}

model Document {
  documentID         String             @id @default(cuid())
  vehicleVIN         String?
  renterID           String?
  renteeID           String?
  verifiedByAdminID  String?
  type               DocumentType
  verificationStatus VerificationStatus @default(Unverified)
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  fileData           Bytes              @db.LongBlob
  iv                 String             @db.VarChar(32)
  authTag            String             @db.VarChar(32)

  vehicle         Vehicle? @relation(fields: [vehicleVIN], references: [VIN], onDelete: Restrict)
  renter          Renter?  @relation(fields: [renterID], references: [renterID], onDelete: Restrict)
  rentee          Rentee?  @relation(fields: [renteeID], references: [renteeID], onDelete: Restrict)
  verifiedByAdmin Admin?   @relation("VerifiedByAdmin", fields: [verifiedByAdminID], references: [adminID], onDelete: SetNull)

  @@index([vehicleVIN])
  @@index([renterID])
  @@index([renteeID])
  @@index([verifiedByAdminID])
}

model Booking {
  bookingID         String        @id @default(cuid())
  vehicleVIN        String
  renteeID          String
  approvedByAdminID String?
  startDate         DateTime      @db.Date
  endDate           DateTime      @db.Date
  status            BookingStatus @default(Pending)
  totalPrice        Decimal       @db.Decimal(12, 2)
  locationConsentAt DateTime?
  createdAt         DateTime      @default(now())

  vehicle         Vehicle       @relation(fields: [vehicleVIN], references: [VIN], onDelete: Restrict)
  rentee          Rentee        @relation(fields: [renteeID], references: [renteeID], onDelete: Restrict)
  approvedByAdmin Admin?        @relation("ApprovedByAdmin", fields: [approvedByAdminID], references: [adminID], onDelete: SetNull)
  payments        Payment[]
  locationLogs    LocationLog[]
  disputes        Dispute[]

  @@index([vehicleVIN])
  @@index([renteeID])
  @@index([approvedByAdminID])
}

model Payment {
  paymentID         String        @id @default(cuid())
  bookingID         String
  amount            Decimal       @db.Decimal(12, 2)
  method            String
  status            PaymentStatus @default(Pending)
  paidAt            DateTime?
  escrowReleaseDate DateTime?

  booking Booking @relation(fields: [bookingID], references: [bookingID], onDelete: Restrict)

  @@index([bookingID])
}

model LocationLog {
  logID      String   @id @default(cuid())
  bookingID  String
  renteeID   String
  latitude   Decimal  @db.Decimal(9, 6)
  longitude  Decimal  @db.Decimal(9, 6)
  accuracy   Decimal? @db.Decimal(8, 2)
  recordedAt DateTime
  speedKph   Decimal? @db.Decimal(8, 2)

  booking Booking @relation(fields: [bookingID], references: [bookingID], onDelete: Restrict)
  rentee  Rentee  @relation(fields: [renteeID], references: [renteeID], onDelete: Restrict)

  @@index([bookingID])
  @@index([renteeID])
}

model Dispute {
  disputeID         String        @id @default(cuid())
  bookingID         String
  resolvedByAdminID String?
  raisedBy          DisputeRaiser
  description       String        @db.Text
  status            DisputeStatus @default(Open)
  resolvedAt        DateTime?
  createdAt         DateTime      @default(now())

  booking         Booking @relation(fields: [bookingID], references: [bookingID], onDelete: Restrict)
  resolvedByAdmin Admin?  @relation("ResolvedByAdmin", fields: [resolvedByAdminID], references: [adminID], onDelete: SetNull)

  @@index([bookingID])
  @@index([resolvedByAdminID])
}

model Notification {
  notificationID String    @id @default(cuid())
  userID         String
  type           String    @db.VarChar(40)
  title          String    @db.VarChar(140)
  body           String    @db.VarChar(500)
  href           String?   @db.VarChar(200)
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID, createdAt])
}
